<Window x:Class="CodexControlCenter.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" SizeChanged="OnShellSizeChanged">
  <Grid.Resources>
   <Style x:Key="MutedTextStyle" TargetType="TextBlock"><Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/></Style>
   <Style x:Key="PanelCardStyle" TargetType="Border"><Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/><Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/></Style>
   <Style x:Key="RowDividerStyle" TargetType="Border"><Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}"/></Style>
   <Style x:Key="StepBadgeStyle" TargetType="Border"><Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/><Setter Property="CornerRadius" Value="9"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}"/><Setter Property="BorderThickness" Value="1"/></Style>
   <Style TargetType="NavigationViewItem"><Setter Property="FontSize" Value="19"/><Setter Property="MinHeight" Value="58"/><Setter Property="HorizontalContentAlignment" Value="Left"/></Style>
  </Grid.Resources>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

  <!-- 标题栏：品牌标记 + 名称，右侧留出窗口控制按钮空间 -->
  <Border Grid.Row="0" Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
   <Grid x:Name="TitleBar" Height="58" Padding="24,0,148,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
     <Border Width="32" Height="32" CornerRadius="9" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
      <TextBlock Text="&gt;_" FontFamily="{StaticResource CodexMonoFont}" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <TextBlock Text="Codex 管理台" FontSize="19" FontWeight="SemiBold" FontFamily="{StaticResource CodexBodyFont}" VerticalAlignment="Center"/>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Margin="14,0,0,0">
     <Rectangle Width="1" Height="14" Fill="{ThemeResource ControlStrokeColorDefaultBrush}" VerticalAlignment="Center"/>
     <TextBlock x:Name="TitleBrand" Text="CONTROL CENTER" FontSize="12" FontFamily="{StaticResource CodexBodyFont}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" CharacterSpacing="140"/>
    </StackPanel>
   </Grid>
  </Border>

  <!-- 导航与工作区 -->
  <NavigationView x:Name="Navigation" Grid.Row="1" PaneDisplayMode="Auto" OpenPaneLength="276" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" IsPaneToggleButtonVisible="True" SelectionChanged="OnNavigationChanged" CompactModeThresholdWidth="1000" ExpandedModeThresholdWidth="1400" FontFamily="{StaticResource CodexBodyFont}">
   <NavigationView.MenuItems>
    <NavigationViewItem Content="概览" Tag="overview"><NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItemSeparator/>
    <NavigationViewItem Content="模型接入" Tag="providers"><NavigationViewItem.Icon><FontIcon Glyph="&#xE774;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="模型列表" Tag="models"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8F1;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="请求记录" Tag="requests"><NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItemSeparator/>
    <NavigationViewItem Content="子代理" Tag="agents"><NavigationViewItem.Icon><FontIcon Glyph="&#xE8D4;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="生图接口" Tag="images"><NavigationViewItem.Icon><FontIcon Glyph="&#xE91B;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="技能与指令" Tag="documents"><NavigationViewItem.Icon><FontIcon Glyph="&#xE734;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="壁纸" Tag="wallpaper"><NavigationViewItem.Icon><FontIcon Glyph="&#xEB9F;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItemSeparator/>
    <NavigationViewItem Content="设置与备份" Tag="settings"><NavigationViewItem.Icon><FontIcon Glyph="&#xE713;"/></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="使用指南" Tag="help"><NavigationViewItem.Icon><FontIcon Glyph="&#xE897;"/></NavigationViewItem.Icon></NavigationViewItem>
   </NavigationView.MenuItems>
   <NavigationView.PaneFooter>
    <Border Style="{StaticResource PanelCardStyle}" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="20,12,20,20">
     <StackPanel Spacing="8">
      <TextBlock Text="运行状态" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorTertiaryBrush}" CharacterSpacing="60"/>
      <TextBlock x:Name="NavStatus" Text="正在读取配置…" FontSize="15" TextWrapping="Wrap"/>
      <TextBlock x:Name="DraftSummary" Text="配置已同步" FontSize="14" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      <Rectangle Height="1" Margin="0,4" Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>
      <TextBlock x:Name="AppVersionLabel" Text="Codex 管理台" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      <TextBlock Text="Ctrl+S 保存当前页" FontSize="13" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
     </StackPanel>
    </Border>
   </NavigationView.PaneFooter>
   <Grid x:Name="WorkspaceArea" Padding="32,20,32,20" SizeChanged="OnShellSizeChanged">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

    <!-- 页面头部：路径标签 + 标题 + 说明 + 主要操作 -->
    <Grid x:Name="PageHeader" Margin="0,0,0,18" RowSpacing="12" ColumnSpacing="24">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel x:Name="PageHeading" Spacing="6">
      <TextBlock x:Name="PageEyebrow" Text="工作区 / 概览" FontSize="13" Foreground="{ThemeResource TextFillColorTertiaryBrush}" CharacterSpacing="40"/>
      <TextBlock x:Name="PageTitle" Text="概览" FontSize="32" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBlock x:Name="PageSubtitle" FontSize="16" Text="查看当前配置与接入状态" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
     </StackPanel>
     <StackPanel x:Name="HeaderActions" Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
      <Button x:Name="QuickSearchButton" Content="查找 · Ctrl+K" Click="OnQuickSearch"/>
      <Button Content="打开 Codex" Click="OnOpenCodex"/>
      <Button x:Name="RefreshButton" Content="刷新状态" Click="OnRefresh"/>
     </StackPanel>
    </Grid>

    <!-- 草稿流程：编辑 → 预览 → 备份保存 -->
    <Border x:Name="WorkflowPanel" Grid.Row="1" Style="{StaticResource PanelCardStyle}" BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,0,0,16">
     <Grid ColumnSpacing="16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" Spacing="10">
       <Grid Width="30" Height="30">
        <Border x:Name="EditBadge" Style="{StaticResource StepBadgeStyle}"><TextBlock Text="1" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <Border x:Name="EditBadgeRing" CornerRadius="9" BorderThickness="2" Visibility="Collapsed" IsHitTestVisible="False"/>
       </Grid>
       <TextBlock x:Name="EditStep" Text="编辑配置" FontSize="17" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
       <Grid Width="30" Height="30">
        <Border x:Name="ReviewBadge" Style="{StaticResource StepBadgeStyle}"><TextBlock Text="2" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <Border x:Name="ReviewBadgeRing" CornerRadius="9" BorderThickness="2" Visibility="Collapsed" IsHitTestVisible="False"/>
       </Grid>
       <TextBlock x:Name="ReviewStep" Text="预览确认" FontSize="17" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
       <Grid Width="30" Height="30">
        <Border x:Name="WriteBadge" Style="{StaticResource StepBadgeStyle}"><TextBlock Text="3" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <Border x:Name="WriteBadgeRing" CornerRadius="9" BorderThickness="2" Visibility="Collapsed" IsHitTestVisible="False"/>
       </Grid>
       <TextBlock x:Name="WriteStep" Text="备份保存" FontSize="17" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
      </StackPanel>
     </Grid>
    </Border>

    <!-- 本页提示 -->
    <Expander Grid.Row="2" HorizontalAlignment="Stretch" Margin="0,0,0,12" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="0">
     <Expander.Header><TextBlock Text="本页怎么用" FontSize="15" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></Expander.Header>
     <StackPanel Spacing="12">
      <TextBlock x:Name="GuideText" FontSize="16" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
      <Button Content="打开完整使用指南" Click="OnOpenHelp"/>
     </StackPanel>
    </Expander>

    <InfoBar x:Name="Banner" Grid.Row="3" IsOpen="False" IsClosable="True" Margin="0,0,0,16"/>
    <ScrollViewer x:Name="PageScroll" Grid.Row="4" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
     <ContentControl x:Name="PageInteraction" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top">
      <Grid x:Name="PageBodies"/>
     </ContentControl>
    </ScrollViewer>
   </Grid>
  </NavigationView>

  <!-- 底部状态栏：当前操作 + 草稿操作 -->
  <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Background="{ThemeResource LayerFillColorDefaultBrush}">
   <Grid x:Name="FooterGrid" Padding="24,12" ColumnSpacing="20" RowSpacing="10">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel x:Name="FooterCopy" Spacing="4" VerticalAlignment="Center">
     <StackPanel Orientation="Horizontal" Spacing="10">
      <Ellipse x:Name="OperationDot" Width="9" Height="9" VerticalAlignment="Center" Fill="{ThemeResource TextFillColorTertiaryBrush}"/>
      <ProgressRing x:Name="OperationRing" Width="18" Height="18" IsActive="False" Visibility="Collapsed"/>
      <TextBlock x:Name="OperationLabel" Text="配置尚未读取" FontSize="16" FontWeight="SemiBold" FontFamily="{StaticResource CodexBodyFont}" TextWrapping="Wrap"/>
     </StackPanel>
     <TextBlock x:Name="FooterMessage" Text="修改后预览，确认再保存" FontSize="14" FontFamily="{StaticResource CodexBodyFont}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
     <TextBlock x:Name="SampleTime" FontSize="12" FontFamily="{StaticResource CodexBodyFont}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
    </StackPanel>
    <StackPanel x:Name="FooterActions" Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
     <Button x:Name="DraftsButton" Content="草稿清单" Click="OnOpenDrafts"/>
     <Button x:Name="DiscardButton" Content="放弃本页草稿" Click="OnDiscard"/>
     <Button x:Name="ApplyButton" Content="预览并保存" Click="OnApply" Style="{StaticResource AccentButtonStyle}" FontSize="18" MinHeight="50" Padding="22,10"/>
    </StackPanel>
   </Grid>
  </Border>
 </Grid>
</Window>
